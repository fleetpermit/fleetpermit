[0.436, "o", "\u001b[1mFleetPermit\u001b[0m — security boundaries\r\n"]
[0.307, "o", "\r\n\u001b[36m\u001b[1m[1/6]\u001b[0m \u001b[1mA lease cannot ask for more tools than the policy allows\u001b[0m\r\n"]
[4.016, "o", "      \u001b[2m$ kubectl create -f wants-read-secret.yaml   # restart_workload + read_secret\u001b[0m\r\n"]
[0.174, "o", "      status: PermissionNotAllowed — tools not permitted by policy sre-remediation: read_secret\r\n"]
[0.117, "o", "      sre-agent       cluster-east  read_secret         \u001b[31m\u001b[1mDENIED\u001b[0m   \u001b[2mAccess to this tool is forbidden.\u001b[0m\r\n"]
[0.000, "o", "\r\n\u001b[36m\u001b[1m[2/6]\u001b[0m \u001b[1mA lease cannot outlive the policy's maximum\u001b[0m\r\n"]
[4.008, "o", "      \u001b[2m$ kubectl create -f one-hour.yaml   # maxDuration is 10m\u001b[0m\r\n"]
[0.183, "o", "      status: DurationExceedsMaximum — requested duration 1h0m0s exceeds policy maximum 10m0s\r\n"]
[0.000, "o", "\r\n"]
[0.000, "o", "\u001b[36m\u001b[1m[3/6]\u001b[0m \u001b[1mA lease cannot be widened after approval\u001b[0m\r\n"]
[4.060, "o", "      \u001b[2m$ kubectl patch toolaccesslease incident-7 --type=json -p '[{\"op\":\"add\",\"path\":\"/spec/permissions/-\",\"value\":{\"tool\":\"read_secret\"}}]'\u001b[0m\r\n"]
[0.047, "o", "      The ToolAccessLease \"incident-7\" is invalid: spec: Invalid value: spec is immutable; create a new ToolAccessLease instead\r\n"]
[0.002, "o", "\r\n\u001b[36m\u001b[1m[4/6]\u001b[0m \u001b[1mMalformed policies are rejected at admission\u001b[0m\r\n"]
[4.016, "o", "      \u001b[2m$ kubectl apply -f bad-policy.yaml   # tool: \"x') || true || ('\", failMode: Open\u001b[0m\r\n"]
[0.054, "o", "      The FleetAccessPolicy \"bad-policy\" is invalid: \r\n      * spec.permissions[0].tool: Invalid value: \"x') || true || ('\": spec.permissions[0].tool in body should match \r\n      '^[A-Za-z0-9][A-Za-z0-9_.-]*$'\r\n      * spec.enforcement.failMode: Unsupported value: \"Open\": supported values: \"Closed\"\r\n      * <nil>: Invalid value: null: some validation rules were not checked because the object was invalid; correct t\r\n      he existing errors to complete validation\r\n"]
